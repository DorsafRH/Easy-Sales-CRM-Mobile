# Copier ce fichier en .env.local puis adapter la valeur à ton réseau.
#   cp .env.example .env.local
#
# URL de base du backend Spring Boot (toujours suffixée par /api).
#   LAN direct    : http://<IP_DU_PC>:8080/api
#   Tunnel HTTPS  : https://<ton-domaine>/api
#
# Préfixe EXPO_PUBLIC_ obligatoire pour exposer la variable au client Expo.
# Après toute modification : relancer avec `npx expo start -c` (cache vidé).
EXPO_PUBLIC_API_URL=http://192.168.1.246:8080/api
